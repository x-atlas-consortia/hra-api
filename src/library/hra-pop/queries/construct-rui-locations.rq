PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ccf: <http://purl.org/ccf/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX HRApop: <https://purl.humanatlas.io/graph/hra-pop>
PREFIX HRA: <https://purl.humanatlas.io/collection/hra-api>

# The entities (tissue blocks, donors, RUI locations, placements, sections, datasets) are found first, and then their
# properties are looked up with a single pattern. Blazegraph is too slow with this query and uses
# construct-rui-locations-blazegraph.rq instead (one large join, which takes QLever longer to plan than to run). The
# result is the same, except that entities missing a property that construct-rui-locations-blazegraph.rq requires are
# included here (with the properties they have) instead of dropped.
CONSTRUCT {
  ?s rdf:type ?type .
  ?s ?p ?o .
}
FROM HRA:
FROM HRApop:
WHERE {
  {
    SELECT DISTINCT ?s ?type
    WHERE {
        {
        SELECT ?rui_location ?dataset
        WHERE {
          # Applies to both branches of the UNION
          #{{DATASET_VALUES}}
          {
            ?block ccf:has_registration_location ?rui_location .
            ?block ccf:generates_dataset ?dataset .
          }
          UNION
          {
            ?block ccf:subdivided_into_sections ?section .
            ?block ccf:has_registration_location ?rui_location .
            ?section ccf:generates_dataset ?dataset .
          }
        }
      }
      UNION
      {
        SELECT ?rui_location ?dataset
        WHERE {
          # Applies to both branches of the UNION
          #{{RUI_LOCATION_VALUES}}
          {
            ?block ccf:has_registration_location ?rui_location .
            ?block ccf:generates_dataset ?dataset .
          }
          UNION
          {
            ?block ccf:subdivided_into_sections ?section .
            ?block ccf:has_registration_location ?rui_location .
            ?section ccf:generates_dataset ?dataset .
          }
        }
      }
      ?block ccf:has_registration_location ?rui_location ;
        ccf:comes_from ?donor ;
        ccf:sample_type ?sampleType .
      FILTER(?sampleType = "Tissue Block")
      ?SpatialPlacement ccf:placement_for ?rui_location .
      OPTIONAL {
        ?block ccf:subdivided_into_sections ?section .
        OPTIONAL { ?section ccf:generates_dataset ?sectionDataset . }
      }
      OPTIONAL { ?block ccf:generates_dataset ?blockDataset . }

      # One row per entity and its type
      VALUES (?role ?type) {
        (1 ccf:Sample) (2 ccf:Donor) (3 ccf:SpatialEntity) (4 ccf:SpatialPlacement)
        (5 ccf:Sample) (6 ccf:Dataset) (7 ccf:Dataset)
      }
      BIND(IF(?role = 1, ?block, IF(?role = 2, ?donor, IF(?role = 3, ?rui_location, IF(?role = 4, ?SpatialPlacement,
        IF(?role = 5, ?section, IF(?role = 6, ?blockDataset, ?sectionDataset)))))) AS ?s)
      FILTER(BOUND(?s))
    }
  }
  # The properties in the CONSTRUCT template of construct-rui-locations-blazegraph.rq
  VALUES ?p {
    rdfs:label rdfs:comment ccf:url ccf:sample_type ccf:generates_dataset ccf:has_registration_location
    ccf:comes_from ccf:subdivided_into_sections ccf:section_count ccf:section_size ccf:section_size_unit
    ccf:sex ccf:age ccf:bmi ccf:consortium_name ccf:tissue_provider_name ccf:tissue_provider_uuid
    dcterms:created dcterms:creator ccf:creator_first_name ccf:creator_last_name ccf:dimension_unit
    ccf:x_dimension ccf:y_dimension ccf:z_dimension ccf:collides_with ccf:slice_count ccf:slice_thickness
    ccf:x_scaling ccf:y_scaling ccf:z_scaling ccf:scaling_unit ccf:x_rotation ccf:y_rotation ccf:z_rotation
    ccf:rotation_order ccf:rotation_unit ccf:x_translation ccf:y_translation ccf:z_translation ccf:translation_unit
    ccf:placement_relative_to ccf:placement_for ccf:section_number ccf:technology ccf:thumbnail
  }
  ?s ?p ?o .
}
